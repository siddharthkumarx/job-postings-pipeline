#!/bin/sh
# Commit-message rule: no trailers except Signed-off-by, and no "Generated with" footer.
# Disallowed lines are removed before the commit is written (see scripts/commit_guard.py).
# Enable with: git config core.hooksPath .githooks
exec python3 "$(git rev-parse --show-toplevel)/scripts/commit_guard.py" --fix "$1"
